# Wyrix configuration. Copy to .env for local reference; export the variables in your shell,
# or put them in GitHub -> Settings -> Secrets and variables -> Actions.
# FreeNewsAPI.ai needs NO key, so the app builds and runs with everything below left empty.

# Optional publisher RSS feeds, "Name|https://feed-url|host" entries separated by ";".
# Only add feeds whose terms permit use in a commercial app.
WYRIX_RSS_FEEDS=

# Release signing (GitHub Secrets). Never commit the keystore.
KEYSTORE_BASE64=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=

# Not wired up yet (see README): ads and push notifications
ADMOB_APP_ID=
ADMOB_BANNER_ID=
FIREBASE_CONFIGURATION=
